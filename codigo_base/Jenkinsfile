// =============================================================================
// Taller Evaluativo 2 - Fase 4: Pipeline Declarativo en Jenkins
//
// Complete los TODOs de cada etapa. Recuerde:
//   - Prohibido el tag ":latest" al publicar en Nexus (empaquetamiento
//     inmutable, Fase 2).
//   - Las credenciales (usuario/clave de Nexus, token de GitHub) se
//     inyectan mediante los IDs configurados en Jenkins > Credentials,
//     NUNCA en texto plano dentro de este archivo.
// =============================================================================

pipeline {
    agent any

    environment {
        // TODO: defina el esquema de versionado inmutable combinando el
        // número de build de Jenkins y los primeros 7 caracteres del
        // commit actual. Pista: use "${env.BUILD_NUMBER}" y
        // "${env.GIT_COMMIT.take(7)}" dentro de un stage con "script {}"
        // (GIT_COMMIT solo está disponible después del checkout).
        // TODO: ajuste host y puerto a los de su Nexus local (Fase 3).
        // TODO: reemplace por el ID exacto de la credencial que usted
        // creó en Jenkins > Manage Jenkins > Credentials (Fase 3.e).
        NEXUS_REGISTRY       = "host.docker.internal:9180"
        NEXUS_MAVEN_REPO     = "http://nexus:8081/repository/maven-releases/"
        NEXUS_CREDENTIALS_ID = "nexus-credentials"
        FRONTEND_API_URL     = "http://localhost:8080"

    }

    stages {

        stage('Checkout & Test') {
            steps {
                checkout scm

                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()
                    env.IMAGE_TAG = "1.0.${env.BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"

                    if (fileExists('backend/pom.xml')) {
                        env.APP_DIR = '.'
                    } else if (fileExists('codigo_base/backend/pom.xml')) {
                        env.APP_DIR = 'codigo_base'
                    } else {
                        error('No se encontró backend/pom.xml en la estructura del repositorio.')
                    }
                }

                dir("${env.APP_DIR}/backend") {
                    sh 'mvn -B -Drevision="$IMAGE_TAG" clean test'
                }
            }
        }

        stage('Package & Tag Inmutable') {
            steps {
                dir("${env.APP_DIR}/backend") {
                    sh 'mvn -B -Drevision="$IMAGE_TAG" clean package -DskipTests'
                    sh '''
                        docker build \
                          --build-arg REVISION="$IMAGE_TAG" \
                          -t "$NEXUS_REGISTRY/studytrack-backend:$IMAGE_TAG" .
                    '''
                }

                dir("${env.APP_DIR}/frontend") {
                    sh '''
                        docker build \
                          --build-arg VITE_API_URL="$FRONTEND_API_URL" \
                          -t "$NEXUS_REGISTRY/studytrack-frontend:$IMAGE_TAG" .
                    '''
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.NEXUS_CREDENTIALS_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    dir("${env.APP_DIR}/backend") {
                        sh '''
                            set +x
                            SETTINGS_FILE="$(pwd)/.jenkins-settings.xml"
                            trap 'rm -f "$SETTINGS_FILE"' EXIT

                            cat > "$SETTINGS_FILE" <<EOF_SETTINGS
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>nexus-releases</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASS}</password>
    </server>
  </servers>
</settings>
EOF_SETTINGS

                            mvn -B \
                              -Drevision="$IMAGE_TAG" \
                              -Dnexus.url="http://nexus:8081" \
                              -DskipTests \
                              -s "$SETTINGS_FILE" \
                              deploy
                        '''
                    }

                    sh '''
                        set +x
                        echo "$NEXUS_PASS" | docker login "$NEXUS_REGISTRY" \
                          --username "$NEXUS_USER" --password-stdin
                        docker push "$NEXUS_REGISTRY/studytrack-backend:$IMAGE_TAG"
                        docker push "$NEXUS_REGISTRY/studytrack-frontend:$IMAGE_TAG"
                        docker logout "$NEXUS_REGISTRY"
                    '''
                }
            }
        }

        stage('Deploy & Smoke Test') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.NEXUS_CREDENTIALS_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$NEXUS_PASS" | docker login "$NEXUS_REGISTRY" \
                          --username "$NEXUS_USER" --password-stdin
                    '''

                    dir("${env.APP_DIR}/deploy") {
                        sh '''
                            docker compose pull
                            docker compose up -d --remove-orphans
                        '''
                    }

                    sh 'docker logout "$NEXUS_REGISTRY"'
                }

                sh '''
                    for i in $(seq 1 12); do
                      if curl -fsS http://host.docker.internal:8080/api/tasks >/dev/null; then
                        echo "Smoke test OK en intento $i"
                        exit 0
                      fi
                      echo "Backend aún no responde; intento $i/12"
                      sleep 5
                    done

                    echo "Smoke test fallido después de 12 intentos"
                    docker ps --filter name=studytrack-backend
                    docker logs --tail 100 studytrack-backend || true
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline finalizado en verde. Artefactos publicados con tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo "El pipeline falló. Revise los logs de la etapa correspondiente antes de reintentar."
        }
    }
}
